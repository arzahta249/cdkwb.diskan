# ==============================================================================
# CDKWB DISKAN ENVIRONMENT CONFIGURATION
# ==============================================================================

# Site Base URL
NEXT_PUBLIC_SITE_URL=https://cdkwb.diskan.jatengprov.go.id
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Firebase Server Configuration (Service Account / Firebase Admin SDK)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Note: Ensure newlines in private key are escaped as \n if entered in a single line
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=

# ------------------------------------------------------------------------------
# Firebase Client Configuration (Firebase Web SDK)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# ImageKit CDN & Media Storage Configuration
# ------------------------------------------------------------------------------
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGEKIT_FOLDER=/diskan

# ------------------------------------------------------------------------------
# Admin Authentication & NextAuth
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Administrator Accounts
ADMIN1_USERNAME=admin1
ADMIN1_PASSWORD=password123
ADMIN2_USERNAME=admin2
ADMIN2_PASSWORD=password123
ADMIN3_USERNAME=admin3
ADMIN3_PASSWORD=password123

# ------------------------------------------------------------------------------
# WhatsApp Gateway & Hotline Configuration (Fonnte / Wablas)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_HOTLINE_WA=08123456789
ADMIN_WA_NUMBER=08123456789
WA_GATEWAY_TOKEN=
WA_GATEWAY_URL=https://api.fonnte.com/send

# ------------------------------------------------------------------------------
# SMTP / Email Notification Configuration
# ------------------------------------------------------------------------------
SMTP_EMAIL=
SMTP_PASSWORD=

# ------------------------------------------------------------------------------
# Legacy Database Configuration (MySQL / HeidiSQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=cdkwb_db
DB_PORT=3306

